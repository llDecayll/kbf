<IfModule mod_rewrite.c>
Options +FollowSymLinks -MultiViews
RewriteEngine On
RewriteBase /

# 1. Strip trailing slash from non-directories (/about/ -> /about)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{THE_REQUEST} \s/+(.+?)/+[\s?] [NC]
RewriteRule ^(.+?)/+$ /$1 [R=301,L]

# 2. Redirect /index.html (or /index) to root /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index(\.html)?[\s?] [NC]
RewriteRule ^index(\.html)?$ / [R=301,L]

# 3. External 301 Redirect: /page.html -> /page
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.html[\s?] [NC]
RewriteRule ^(.+?)\.html$ /$1 [R=301,L,NE]

# 4. Internal Rewrite: /page -> /page.html if exists in current dir or dist/
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)$ $1.html [L]

RewriteCond %{DOCUMENT_ROOT}/dist/$1.html -f
RewriteRule ^(.+?)$ dist/$1.html [L]

RewriteCond %{DOCUMENT_ROOT}/dist -d
RewriteRule ^$ dist/index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType text/html .html
  AddType text/css .css
  AddType application/javascript .js
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>
